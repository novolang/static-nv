// staticpath.nv — a URL path turned into a path inside a root, or
// refused.  The load-bearing module of this package, and it performs
// nothing.
//
// THE ORDER OF THE TWO STEPS IS THE WHOLE SECURITY ARGUMENT, and it is
// the opposite of what a reader expects.
//
//   1. SPLIT on the literal `/` bytes of the request target.
//   2. PERCENT-DECODE each segment.
//   3. CHECK each decoded segment.
//
// Decoding before splitting is the bug.  `/files/%2e%2e/%2e%2e/etc/passwd`
// has no `..` in it as it arrives: a check run first sees `%2e%2e`,
// passes it, and the decode afterwards produces exactly the traversal
// the check was for.  So the check runs LAST, on the decoded segment.
//
// Splitting after decoding is the other bug, and it is subtler.
// `/files/a%2Fb` is ONE segment whose name contains a slash — a file
// called `a/b`, which does not exist on any filesystem this package
// runs on, because the operating system will read that slash as a
// separator.  A resolver that decoded first would see two segments and
// hand back a path one directory deeper than the request named.  So
// the split runs FIRST, on the literal bytes, and a segment that
// decodes to something containing a separator is REFUSED rather than
// accepted or re-split.
//
// This is the same argument router-nv makes about matching before
// decoding, arrived at from the other end.
//
// WHAT `[]` BUYS.  Path traversal is the oldest vulnerability a file
// server has and the reason it keeps happening is that the rules are
// usually checked against a filesystem: a suite covers the ten inputs
// somebody thought of, and the eleventh is a CVE.  Nothing in this
// module touches a disk, so its whole rule set is a table of strings
// in `staticpath_tests.nv` — every refusal, with the input that
// triggers it, readable in one screen.  A reviewer auditing this
// package reads that file.
//
// WHAT `[]` CANNOT BUY: SYMLINKS.  A lexical resolver proves that the
// path it built is inside the root as a STRING.  It cannot know that
// `root/uploads/x` is a symbolic link to `/etc/shadow`, because
// finding that out means asking the filesystem and this module asks it
// nothing.  `staticfs` does not ask either: its one containment
// answer, `staticfs.containment_is_lexical_only`, says so out loud
// rather than letting a deployment assume otherwise.  A caller that
// wants the second check has `fs.realpath` — resolve the root and the
// file and compare the two — and a root that contains no symbolic link
// is safe without it.  The honest interface is the one that says
// which, and a root that accepts uploads and follows them needs the
// check.

use std.list
use std.str
use staticerr

// What a request target resolved to.
//
// Five answers, because a static file server genuinely has five —
// and a resolver that answered `?Str` would collapse the middle three
// into "no file", which is how a directory ends up 404ing instead of
// redirecting.
pub enum StaticResolved
    // A file inside the root.  The path is RELATIVE to the root and
    // every segment has been checked, so joining it to the root
    // cannot leave the root.
    StaticFile(relative: Str)
    // A directory with an index file, and the index's relative path.
    StaticIndex(relative: Str)
    // A directory with no index file.  The policy decides between a
    // listing and a 404; the resolver does not, because listing a
    // directory is a disclosure decision and not a path decision.
    StaticDirectory(relative: Str)
    // A directory requested WITHOUT a trailing slash.  The answer is a
    // 301 to the same path with one — and it is not cosmetic: every
    // relative link on the page served from `/docs` resolves against
    // `/`, and the same page served from `/docs/` resolves against
    // `/docs/`.  A server that skips this redirect serves a page whose
    // stylesheet and images 404.
    StaticRedirect(location: Str)
    // Refused, and why.
    StaticRefused(reason: staticerr.StaticRefusal)

// What a deployment decides about its own files.
pub struct StaticPolicy
    // The index file names, tried in order.  `index.html` alone by
    // default; a list because a deployment with `index.htm` exists.
    index_names: [Str]
    // Whether a directory with no index is listed.  FALSE by default:
    // a listing publishes every file name in a directory, which is how
    // a backup file nobody meant to deploy is found.
    list_directories: Bool
    // Whether a segment beginning with a dot may be served.  FALSE:
    // `.git`, `.env` and `.htpasswd` are the three most-scanned paths
    // on the internet and every one of them is a dotfile.
    serve_hidden: Bool
    // Whether a directory without a trailing slash gets a redirect.
    // TRUE; see `StaticRedirect` for why it is not cosmetic.
    redirect_directories: Bool
    // The most segments a path may have.
    max_segments: Int
    // The most bytes a path may have.
    max_bytes: Int

// The conventional policy: `index.html`, no listings, no dotfiles,
// redirect directories, 32 segments, 1024 bytes.
//
// Every one of those defaults is the restrictive choice, and the two
// that matter are `list_directories` and `serve_hidden` — both false,
// both the setting a deployment turns on deliberately or not at all.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.defaults().list_directories}")
// ```
pub fn defaults() -> StaticPolicy []
    StaticPolicy {
        index_names: ["index.html"],
        list_directories: false,
        serve_hidden: false,
        redirect_directories: true,
        max_segments: 32,
        max_bytes: 1024 }

// The same policy with directory listings on.
//
// For a file-drop, a documentation archive, a release directory — the
// cases where the listing IS the page.  Named rather than a field
// somebody sets absently, because turning it on publishes every file
// name in every directory under the root.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.with_listings(staticpath.defaults()).list_directories}")
// ```
pub fn with_listings(p: StaticPolicy) -> StaticPolicy []
    StaticPolicy {
        index_names: p.index_names,
        list_directories: true,
        serve_hidden: p.serve_hidden,
        redirect_directories: p.redirect_directories,
        max_segments: p.max_segments,
        max_bytes: p.max_bytes }

// The same policy with a different set of index file names.
//
// ```novo
// use std.list
// use staticpath
//
// fn main() [io]
//     let p = staticpath.with_index_names(staticpath.defaults(), ["index.html", "index.htm"])
//     println("${list.len(p.index_names)}")
// ```
pub fn with_index_names(p: StaticPolicy, names: [Str]) -> StaticPolicy []
    StaticPolicy {
        index_names: names,
        list_directories: p.list_directories,
        serve_hidden: p.serve_hidden,
        redirect_directories: p.redirect_directories,
        max_segments: p.max_segments,
        max_bytes: p.max_bytes }

// The same policy serving dotfiles.
//
// There is one honest use — a `.well-known` directory, which every
// ACME certificate renewal needs — and `is_well_known` below is the
// predicate that admits that one directory without admitting the rest.
// Reach for this only where the root genuinely holds nothing private,
// and know that `.git` is a directory a scanner asks for by name on
// every site it meets.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.with_hidden(staticpath.defaults()).serve_hidden}")
// ```
pub fn with_hidden(p: StaticPolicy) -> StaticPolicy []
    StaticPolicy {
        index_names: p.index_names,
        list_directories: p.list_directories,
        serve_hidden: true,
        redirect_directories: p.redirect_directories,
        max_segments: p.max_segments,
        max_bytes: p.max_bytes }

// Whether a first segment is the one dotted path that has to work.
//
// `.well-known` (RFC 8615) is how an ACME certificate renewal proves
// control of a domain, and a static file server that refuses every
// dotted segment refuses it too — which is a certificate that does not
// renew, three months after anyone was looking.  Published as a
// predicate so a caller's policy check can admit that one directory
// without admitting `.git`.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.is_well_known(".well-known")}")
// ```
pub fn is_well_known(segment: Str) -> Bool []
    segment == ".well-known"

// ── The resolver ─────────────────────────────────────────────────────

// A directory and one name inside it: the slash belongs between them
// only where the directory is not the root itself, which is empty.
fn child(dir: Str, name: Str) -> Str
    if dir == ""
        return name
    let prefix = dir + "/"
    let joined = prefix + name
    joined

// The first index name that is a file inside a directory, or the
// directory itself where none of them is.
fn index_of(relative: Str, p: StaticPolicy, exists: fn(Str) -> Int []) -> StaticResolved
    for name in p.index_names
        let candidate = child(relative, name)
        if exists(candidate) == kind_file()
            return StaticIndex(candidate)
    StaticDirectory(relative)

// The filesystem half of `resolve`: one `exists` question about the
// checked path, and the redirect where the target named a directory
// without a trailing slash.
fn checked_kind(relative: Str, target: Str, p: StaticPolicy,
                exists: fn(Str) -> Int []) -> StaticResolved
    if exists(relative) == kind_file()
        return StaticFile(relative)
    if not str.ends_with(target, "/") and p.redirect_directories
        return StaticRedirect(directory_redirect(target, ""))
    index_of(relative, p, exists)

// A request target resolved against a root, WITHOUT touching a disk.
//
// The `exists` argument is what makes that possible: it is a predicate
// the caller supplies, answering whether a relative path is a file, a
// directory, or neither.  A deployment backs one with the index it
// scanned at start-up, which `staticfs.lookup` answers from a value; a
// test passes one backed by a list of strings, which is what lets the
// entire rule set be asserted with no directory in the room.  A
// predicate that reads a disk cannot go here — this module is `[]`, and
// the checker refuses the wider row.
//
// The steps, in this order:
//
//   1. split the target on literal `/` bytes;
//   2. percent-decode each segment;
//   3. check each decoded segment against every rule in
//      `staticerr.StaticRefusal`;
//   4. ask `exists` about the assembled relative path.
//
// Step 2 before step 3 is what catches `%2e%2e`.  Step 1 before step 2
// is what catches `%2F`.  Both orders are wrong the other way round
// and both have CVEs behind them.
//
// The query string is not stripped here — pass `HttpRequest.path`,
// which the standard library has already separated.
//
// ```novo
// use staticpath
//
// fn kinds(relative: Str) -> Int
//     if relative == "index.html"
//         1
//     else
//         0
//
// fn main() [io]
//     match staticpath.resolve("/index.html", staticpath.defaults(), kinds)
//         StaticFile(r)     => println(r)
//         StaticIndex(r)    => println(r)
//         StaticDirectory(r) => println(r)
//         StaticRedirect(l) => println(l)
//         StaticRefused(_)  => println("refused")
// ```
pub fn resolve(target: Str, p: StaticPolicy, exists: fn(Str) -> Int []) -> StaticResolved []
    match check(target, p)
        Err(r)       => StaticRefused(r)
        Ok(relative) => checked_kind(relative, target, p, exists)

// The integer `exists` answers for "not there".
//
// The three codes are functions rather than an enum so that the
// predicate a caller writes is a plain `fn(Str) -> Int` — which is
// what lets it be a closure over a list in a test and a lookup in an
// index with no trait in between.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.kind_missing()}")
// ```
pub fn kind_missing() -> Int []
    0

// The integer `exists` answers for a regular file.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.kind_file()}")
// ```
pub fn kind_file() -> Int []
    1

// The integer `exists` answers for a directory.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.kind_directory()}")
// ```
pub fn kind_directory() -> Int []
    2

// The resolution alone, with no `exists` question: the checked
// relative path, or a refusal.
//
// For a caller that has its own idea of what a path resolves to — a
// bundle read out of a zip, an index built at deploy time, a
// content-addressed store.  Every rule in `staticerr.StaticRefusal`
// still applies; what is skipped is only the "is it there" half.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     match staticpath.check("/css/site.css", staticpath.defaults())
//         Ok(r)  => println(r)
//         Err(_) => println("refused")
// ```
pub fn check(target: Str, p: StaticPolicy) -> Result<Str, staticerr.StaticRefusal> []
    if not str.starts_with(target, "/")
        return Err(staticerr.StaticNotRooted)
    let segs = segments(target)
    let count = list.len(segs)
    if count > p.max_segments
        return Err(staticerr.StaticTooDeep(count, p.max_segments))
    var index = 0
    for s in segs
        match check_segment(s, index, p)
            None    =>
                index = index + 1
            Some(r) =>
                return Err(r)
    let relative = str.join(segs, "/")
    let n = str.len(relative)
    if n > p.max_bytes
        return Err(staticerr.StaticTooLong(n, p.max_bytes))
    Ok(relative)

// A checked relative path joined to a root.
//
// The one place the two halves meet, and the only function that
// produces a filesystem path.  Takes a relative path that `check` or
// `resolve` produced — nothing else — which is why it is total: every
// segment of that relative path has already been through every rule.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println(staticpath.join_root("/srv/site", "css/site.css"))
// ```
pub fn join_root(root: Str, relative: Str) -> Str []
    if relative == ""
        return root
    if str.ends_with(root, "/")
        let joined = root + relative
        return joined
    let prefix = root + "/"
    let joined = prefix + relative
    joined

// The relative path a resolution names, or empty for a refusal.
//
// ```novo
// use staticpath
//
// fn kinds(relative: Str) -> Int
//     staticpath.kind_missing()
//
// fn main() [io]
//     let r = staticpath.resolve("/a.txt", staticpath.defaults(), kinds)
//     println(staticpath.relative_of(r))
// ```
pub fn relative_of(r: StaticResolved) -> Str []
    match r
        StaticFile(relative)      => relative
        StaticIndex(relative)     => relative
        StaticDirectory(relative) => relative
        StaticRedirect(_)         => ""
        StaticRefused(_)          => ""

// Whether a resolution names something to serve.
//
// True for a file and an index; false for a directory, a redirect and
// a refusal.
//
// ```novo
// use staticpath
//
// fn kinds(relative: Str) -> Int
//     staticpath.kind_missing()
//
// fn main() [io]
//     let r = staticpath.resolve("/a.txt", staticpath.defaults(), kinds)
//     println("${staticpath.is_servable(r)}")
// ```
pub fn is_servable(r: StaticResolved) -> Bool []
    match r
        StaticFile(_)      => true
        StaticIndex(_)     => true
        StaticDirectory(_) => false
        StaticRedirect(_)  => false
        StaticRefused(_)   => false

// ── The rules, individually ──────────────────────────────────────────
//
// Published one by one, because "the resolver is safe" is not a claim
// a reader can check and "this is what `..` does after decoding" is.

// One byte of a percent triple as a number, or -1 where it is not a
// hex digit.  Every dot, slash and NUL this module refuses arrived as
// a pair of these.
fn hex_value(b: Int) -> Int
    if b >= '0' and b <= '9'
        return b - '0'
    if b >= 'A' and b <= 'F'
        return b - 'A' + 10
    if b >= 'a' and b <= 'f'
        return b - 'a' + 10
    -1

// The decode half of the order this module argues for: one raw segment
// becomes the bytes it names.  A `%` that does not begin a well-formed
// triple is left as the literal byte it is, because a percent sign is
// a legal character in a file name.
fn decode_segment(raw: Str) -> Str
    let n = str.len(raw)
    let sb = str.builder_new()
    var i = 0
    while i < n
        let b = str.byte_at_or(raw, i, 0)
        if b == '%' and i + 2 < n
            let hi = hex_value(str.byte_at_or(raw, i + 1, 0))
            let lo = hex_value(str.byte_at_or(raw, i + 2, 0))
            if hi >= 0 and lo >= 0
                str.builder_append_char(sb, hi * 16 + lo)
                i = i + 3
            else
                str.builder_append_char(sb, b)
                i = i + 1
        else
            str.builder_append_char(sb, b)
            i = i + 1
    let decoded = str.builder_to_str(sb)
    str.builder_drop(sb)
    decoded

// Every segment of a target, split on literal `/` and percent-decoded,
// in order.
//
// The intermediate value `resolve` checks, exposed so a test can
// assert the SPLIT and the DECODE separately from the rules — which is
// what proves the order the module comment argues for.
//
// ```novo
// use std.list
// use staticpath
//
// fn main() [io]
//     println("${list.len(staticpath.segments("/a/b/c.txt"))}")
// ```
pub fn segments(target: Str) -> [Str] []
    let parts = str.split(target, "/")
    var out: [Str] = []
    for part in parts
        if part != ""
            out = list.push(out, decode_segment(part))
    out

// The first byte below 0x20 in a decoded segment, or -1 where it has
// none.  NUL and a control byte are one search and two refusals.
fn forbidden_byte(decoded: Str) -> Int
    let n = str.len(decoded)
    var i = 0
    while i < n
        let b = str.byte_at_or(decoded, i, 0)
        if b < ' '
            return b
        i = i + 1
    -1

// Whether a DECODED segment is one this package will build a path
// from.
//
// `None` when it is.  The whole rule set for one segment, so a reader
// checking the resolver reads this and its test rather than a
// paragraph.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     match staticpath.check_segment("..", 0, staticpath.defaults())
//         Some(_) => println("refused")
//         None    => println("fine")
// ```
pub fn check_segment(decoded: Str, index: Int, p: StaticPolicy) -> ?staticerr.StaticRefusal []
    if is_dot_segment(decoded)
        return Some(staticerr.StaticTraversal(index))
    let bad = forbidden_byte(decoded)
    if bad == 0
        return Some(staticerr.StaticNulByte(index))
    if bad > 0
        return Some(staticerr.StaticControlByte(index, bad))
    if str.contains(decoded, "/")
        return Some(staticerr.StaticEncodedSeparator(index))
    if str.contains(decoded, "\\")
        return Some(staticerr.StaticBackslash(index))
    if is_hidden(decoded) and not p.serve_hidden and not (index == 0 and is_well_known(decoded))
        return Some(staticerr.StaticHiddenSegment(index))
    None

// Whether a decoded segment contains a byte that would act as a path
// separator on any platform this package runs on: `/` or `\`.
//
// The check that makes `%2F` a refusal rather than a decode.  A name
// containing a separator is a name that reaches out of its directory,
// and there is no operating system where it means what the request
// said.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.has_separator("a/b")}")
// ```
pub fn has_separator(decoded: Str) -> Bool []
    if str.contains(decoded, "/")
        return true
    str.contains(decoded, "\\")

// Whether a decoded segment holds a byte no file name legitimately
// has: NUL, or anything below 0x20.
//
// The NUL half is the one with the history: `/safe.txt%00.jpg`
// truncating to `/safe.txt` is how an extension allow-list was walked
// past in half a dozen languages.  The control half is quieter — a
// newline in a file name is a newline in a log line, and a log a
// person can be lied to with is a log that is not evidence.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.has_forbidden_byte("ok.txt")}")
// ```
pub fn has_forbidden_byte(decoded: Str) -> Bool []
    forbidden_byte(decoded) >= 0

// Whether a decoded segment is `.` or `..`.
//
// Checked after decoding, which is the half that matters.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.is_dot_segment("..")}")
// ```
pub fn is_dot_segment(decoded: Str) -> Bool []
    decoded == "." or decoded == ".."

// Whether a decoded segment begins with a dot.
//
// `.git`, `.env`, `.htpasswd`, `.DS_Store`, `.svn` — the directory a
// scanner asks every site for, and the file a framework writes secrets
// into.  `.well-known` is the one exception and `is_well_known` is how
// a policy admits it.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println("${staticpath.is_hidden(".env")}")
// ```
pub fn is_hidden(decoded: Str) -> Bool []
    str.starts_with(decoded, ".")

// The redirect location for a directory requested without a trailing
// slash: the same target with one appended, query string preserved.
//
// The query has to survive, because a directory link carrying one
// (`/docs?lang=en`) that loses it on the redirect loses the thing the
// person asked for.
//
// ```novo
// use staticpath
//
// fn main() [io]
//     println(staticpath.directory_redirect("/docs", "lang=en"))
// ```
pub fn directory_redirect(target: Str, query: Str) -> Str []
    let with_slash = target + "/"
    if query == ""
        return with_slash
    let prefix = with_slash + "?"
    let full = prefix + query
    full
